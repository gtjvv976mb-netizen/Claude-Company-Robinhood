node_modules/
burner.json
.cc-executor.env
.cc-executor.sqlite*
.cc-executor.lock
PAUSE_ENTRIES
HARD_STOP

# Rollback copies written by macos-release.sh carry the feed secret and RPC keys;
# the manual round-trip probe keeps its own journal. Neither may ever be staged.
.cc-executor.env.previous-*
.roundtrip-test.sqlite*

# A private key must never be stageable. install-secret.sh writes burner.key INTO this
# directory, and this remote is public — only burner.json (the Solana name) was covered.
burner.key
*.key
.cc-executor.env.*
