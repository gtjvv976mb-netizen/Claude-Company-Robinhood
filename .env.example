# Claude Company for Robinhood — local configuration.
# Copy to .env. Every value here is a placeholder; .env is git-ignored and must stay so.

# ---- required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- the chain: Robinhood Chain, chainId 4663 (0x1237), Arbitrum Nitro ----
# The public RPC works and is the default, but it 429s on batches over ~10 requests and
# holder replays are batches. A second provider in RH_RPC_SECONDARY is used as the
# fallback and for the executor's two-RPC coherence checks. Never cache eth_gasPrice:
# it moved 0.02 -> 0.7 gwei in two weeks and spikes above 5 gwei; it is read per ticket.
RH_RPC=https://rpc.mainnet.chain.robinhood.com
RH_RPC_SECONDARY=

# ---- optional ----
# GeckoTerminal (network slug `robinhood`) and DexScreener (chainId `robinhood`) need no
# key. The KyberSwap aggregator wants a client id in x-client-id; any stable string.
KYBER_CLIENT_ID=claude-company-robinhood

# ---- desk configuration ----
DESK_EQUITY_USD=10000          # notional book size used for position sizing
DESK_MAX_RISK_PCT=1.0          # max % of equity risked on a single idea
DESK_MAX_CANDIDATES=8          # LLM agents run on at most this many per cycle
# The Solana floors (liquidity, pair age, probe size) are VOID here and are registered as
# `inherited` in executor/live-thresholds.mjs; the executor refuses to arm until each is
# re-measured on 4663. Override only with a number you measured.
DESK_MIN_LIQUIDITY_USD=
DESK_MIN_PAIR_AGE_HOURS=
DESK_TARGET_SIZE_USD=

# ---- the CEO's door ----
# PUBLIC address only. Used to PREPARE an unsigned transaction for you to sign yourself.
# The hosted desk accepts only this public address. Never put a private key in hosted config.
DESK_WALLET_ADDRESS=
DESK_MODEL_CEO=claude-opus-5

# Prepare an unsigned swap transaction alongside the chart link. OFF by default and it
# should usually stay off: a transaction this desk composed, that you approve routinely,
# hands it the privilege that actually matters.
DESK_PREPARE_TX=0

# ---- floor leasing (the access token) ----
# The PUBLIC EVM address that receives $CLAUDECO for floors. Create it in your own wallet;
# the hosted leasing service accepts only this public address.
# Leasing stays closed until this is set.
TREASURY_OWNER_RH=

# The Robinhood edition of $CLAUDECO is NOT launched. This is the placeholder; the launch
# (docs/LAUNCH-CHECKLIST.md) replaces it. Leasing stays closed while it is all zeros.
CLAUDECO_RH_TOKEN=0x7039986CaC6C7885b53f10c7492E653055470ab9
CLAUDECO_RH_DECIMALS=18
# Price per floor in whole tokens. Denominated in the token, not dollars, on purpose:
# a USD-pegged price read off a thin market is trivially manipulated.
FLOOR_PRICE_CLAUDECO=1000000
RUN_PRICE_CLAUDECO=250000
FREE_RUNS_WITH_LEASE=5

# ---- the penthouse desk ----
PENTHOUSE_ENABLED=1
PENTHOUSE_CYCLE_MINS=360     # research 4x a day; each cycle costs ~3 workups (~$5)
PENTHOUSE_MONITOR_MINS=10    # exit checks: prices and chain flags only, no model calls
PENTHOUSE_WORKUPS=3          # how many candidates get the expensive 14 seats per cycle
PENTHOUSE_TOP_N=5            # how many approved calls go on the sheet

# ---- Codex improvement review (GitHub Actions side; Render holds the same token) ----
# Read-only bearer for this fork's own review bundle. Must differ from the Solana desk's.
CODEX_REVIEW_TOKEN=
